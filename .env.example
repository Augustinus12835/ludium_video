# Copy to .env and fill in. ElevenLabs is the ONLY paid API the math and technical
# pipeline needs — every LLM step runs as a Claude Code subagent under your Claude
# subscription. The humanities (folio) pipeline adds two image keys: see the
# section at the bottom.

# ElevenLabs — the key must have BOTH text_to_speech and speech_to_text enabled.
ELEVENLABS_API_KEY=sk_...

# The narrator voice (any ElevenLabs voice ID, including a cloned voice).
ELEVENLABS_VOICE_ID=...

# Pronunciation dictionary applied to every TTS request (fixes sinh/cosh,
# Greek-letter words, math abbreviations). Part of the default setup:
#   python scripts/setup_pronunciation_dict.py
# uploads the bundled docs/elevenlabs_pronunciation_dict.pls to your account
# and fills this in. Keyed by ID only, so the latest dictionary version is
# always used — add entries to the live dictionary to suit your production
# needs (proper nouns, domain terms, recurring acronyms).
ELEVENLABS_PRONUNCIATION_DICT_ID=

# Optional overrides (defaults shown)
#ELEVENLABS_STT_MODEL=scribe_v2      # Scribe transcription model
#MANIM_RENDER_JOBS=2                 # parallel Manim frame renders
#MANIM_RENDER_TIMEOUT=1800           # seconds per frame render (raise for dense 4K frames)
#SUBTITLE_DRIFT_TOLERANCE=0.5        # seconds; raise to ~1.0 for very long videos
#SKIP_NARRATION_CHECK=               # set to 1 only to bypass a confirmed false positive

# ---------------------------------------------------------------------------
# Humanities pipeline (--folio) only — not needed for math/technical videos.
# Images: roughly US$5-7 per 20-minute episode.
# ---------------------------------------------------------------------------

# OpenAI Images API — engraved plates, portraits, objects and then-states.
OPENAI_API_KEY=
# Google Gemini API (aistudio.google.com/apikey) — grounded maps (Gemini 3 Pro Image
# + Google Search); also every image when FOLIO_DEFAULT_TIER=lite.
GOOGLE_CLOUD_API_KEY=

# Optional overrides (defaults shown)
#FOLIO_GPT_MODEL=gpt-image-2         # OpenAI image model for folio assets
#FOLIO_DEFAULT_TIER=gpt              # lite = Gemini flash-lite for every non-map image
#REMOTION_RENDER_TIMEOUT=1800        # seconds per scene render
